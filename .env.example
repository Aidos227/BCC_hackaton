# Скопируйте этот файл в .env и впишите ключ. Файл .env в git не попадает (.gitignore).

# Вариант по умолчанию — бесплатный Gemini API (Google AI Studio): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Модель Gemini (можно не менять)
GEMINI_MODEL=gemini-3.6-flash
# Запасные модели, если основная перегружена (503) или исчерпан бесплатный лимит (429)
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite

# Альтернатива — Claude API (платно): https://console.anthropic.com/
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Альтернатива — любой OpenAI-совместимый сервер (OpenAI, OpenRouter, локальный Ollama / LM Studio)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen2.5:14b

# Если заданы несколько ключей, выбрать провайдера явно: gemini | anthropic | openai
# LLM_PROVIDER=gemini

# Необязательно
# LLM_TEMPERATURE=0.0
# LLM_TIMEOUT_SEC=300
# LLM_MAX_RETRIES=5
